{
  "redirects": [
    {
      "source": "/learning",
      "destination": "/learnings",
      "permanent": true
    },
    {
      "source": "/archive",
      "destination": "/works",
      "permanent": true
    },
    {
      "source": "/talk",
      "destination": "/talks/interview",
      "permanent": false
    },
    {
      "source": "/talk/presenter",
      "destination": "/talks/interview/presenter",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "https://api.yarikama.com/api/v1/sitemap.xml"
    },
    {
      "source": "/love",
      "destination": "https://love-site-alpha-nine.vercel.app/love/"
    },
    {
      "source": "/love/:path*",
      "destination": "https://love-site-alpha-nine.vercel.app/love/:path*"
    },
    {
      "source": "/((?!favicon\\.svg$|assets/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
        },
        {
          "key": "Reporting-Endpoints",
          "value": "csp=\"https://api.yarikama.com/api/v1/csp-report\""
        },
        {
          "key": "Content-Security-Policy-Report-Only",
          "value": "default-src 'self'; script-src 'self' 'sha256-Wk6t6eaMRvCdcP5ezmiLutCTfrH4jxOBhLpRQYtGCKY='; style-src 'self' https://fonts.googleapis.com; style-src-attr 'unsafe-inline'; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' https://assets.yarikama.com data:; media-src 'self' https://assets.yarikama.com; connect-src 'self' https://api.yarikama.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; report-uri https://api.yarikama.com/api/v1/csp-report; report-to csp"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/favicon.png",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Link",
          "value": "</hero/sky.webp>; rel=preload; as=image; fetchpriority=high, </hero/bridge.webp>; rel=preload; as=image; fetchpriority=high, </hero/buildings.webp>; rel=preload; as=image; fetchpriority=high, </hero/people.webp>; rel=preload; as=image; fetchpriority=high, </hero/henry.webp>; rel=preload; as=image; fetchpriority=high"
        }
      ]
    },
    {
      "source": "/hero/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/travel/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ]
}
